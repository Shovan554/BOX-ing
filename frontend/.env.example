# Optional. When unset, dev uses http(s)://<host>:8000 and ws(s)://<host>:8000 (Vite + local API).

# Production / staging: your Render (or other) FastAPI origin — no trailing slash
# VITE_API_URL=https://your-api.onrender.com

# Optional override if WebSocket is not http→ws / https→wss of VITE_API_URL
# VITE_WS_URL=wss://your-api.onrender.com
